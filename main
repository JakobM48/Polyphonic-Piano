#include <xc.h>
#include <stdio.h>
#include "lcd.h"

//set internal osc to 8MHz
#define _XTAL_FREQ 8000000

//configs
#pragma config MCLRE = OFF  
#pragma config PBADEN = DIG 
#pragma config OSC = INTIO2
#pragma config WDT = OFF
#pragma config LVP = OFF

// Pin Definitions
#define Play_C PORTBbits.RB0
#define Play_CS PORTBbits.RB1
#define Play_D PORTBbits.RB2
#define Play_DS PORTBbits.RB3
#define Play_E PORTBbits.RB4
#define Play_F PORTBbits.RB5
#define Play_FS PORTBbits.RB6
#define Play_G PORTBbits.RB7
#define Play_GS PORTAbits.RA0
#define Play_A PORTAbits.RA1
#define Play_AS PORTAbits.RA2
#define Play_B PORTAbits.RA3
#define Octave_Up PORTCbits.RC7
#define Octave_Down PORTCbits.RC6
#define Speaker LATCbits.LATC2

//phase steps to output frequencies
uint16_t phase_steps[] = {1647, 1745, 1849, 1959, 2075, 2199, 2329, 2468, 2615, 2770, 2935, 3110 };

//Pre-calculated steps adjusted for octave
volatile uint16_t adjusted_steps[12] = {0}; 

//note logic variables
uint16_t accumulators[12] = {0}; 
volatile uint8_t notes_active[12] = {0};  
volatile int8_t octave_level = 0; 

//lcd update flag
volatile uint8_t update_lcd_flag = 1; 

//array to store note names
const char* note_names[] = {"C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"};

//leanest possible ISR (no for loop)
void __interrupt() high_isr(void)
{
    if (INTCONbits.TMR0IF) {
        TMR0 = 65536 - 200; 
        
        uint8_t total_toggle = 0;

        //accumulator logic
        if(notes_active[0]) { accumulators[0] += adjusted_steps[0]; if(accumulators[0] & 0x8000) total_toggle = 1; }      //C
        if(notes_active[1]) { accumulators[1] += adjusted_steps[1]; if(accumulators[1] & 0x8000) total_toggle = 1; }      //C#
        if(notes_active[2]) { accumulators[2] += adjusted_steps[2]; if(accumulators[2] & 0x8000) total_toggle = 1; }      //D
        if(notes_active[3]) { accumulators[3] += adjusted_steps[3]; if(accumulators[3] & 0x8000) total_toggle = 1; }      //D#
        if(notes_active[4]) { accumulators[4] += adjusted_steps[4]; if(accumulators[4] & 0x8000) total_toggle = 1; }      //E
        if(notes_active[5]) { accumulators[5] += adjusted_steps[5]; if(accumulators[5] & 0x8000) total_toggle = 1; }      //F
        if(notes_active[6]) { accumulators[6] += adjusted_steps[6]; if(accumulators[6] & 0x8000) total_toggle = 1; }      //F#
        if(notes_active[7]) { accumulators[7] += adjusted_steps[7]; if(accumulators[7] & 0x8000) total_toggle = 1; }      //G
        if(notes_active[8]) { accumulators[8] += adjusted_steps[8]; if(accumulators[8] & 0x8000) total_toggle = 1; }      //G#
        if(notes_active[9]) { accumulators[9] += adjusted_steps[9]; if(accumulators[9] & 0x8000) total_toggle = 1; }      //A
        if(notes_active[10]) { accumulators[10] += adjusted_steps[10]; if(accumulators[10] & 0x8000) total_toggle = 1; }  //A#
        if(notes_active[11]) { accumulators[11] += adjusted_steps[11]; if(accumulators[11] & 0x8000) total_toggle = 1; }  //B

        Speaker = total_toggle; 
        INTCONbits.TMR0IF = 0;
    }
}

void setup() {
    OSCCON = 0x70;  
    OSCTUNE = 0x0F; 
    ADCON1 = 0x0F;   
    RCSTAbits.SPEN = 0; 
    TXSTAbits.TXEN = 0; 
    
    //pin setups
    TRISB = 0xFF; TRISA = 0xFF; TRISCbits.TRISC2 = 0;
    TRISCbits.TRISC7 = 1; TRISCbits.TRISC6 = 1;
    
    //lcd initialization call
    LCD_init();
    
    //timer logic
    T0CON = 0x08;  
    TMR0 = 65536 - 200;
    INTCONbits.TMR0IE = 1;
    INTCONbits.GIE = 1;  
    T0CONbits.TMR0ON = 1;
}

void main(void) {
    setup();
    
    //state logic for octave buttons
    uint8_t last_up_state = 1, last_down_state = 1;
    
    //chord mask for storing button states
    uint16_t last_chord_mask = 0;

    while(1) {
        // Octave Logic
        if (Octave_Up == 0 && last_up_state == 1) {
            
            //debounce
            __delay_ms(20); 
            
            //changes octaves up to 2 additional octaves, updates lcd flag
            if (Octave_Up == 0 && octave_level < 2) { octave_level++; update_lcd_flag = 1; }
        }
        //update state
        last_up_state = Octave_Up;

        if (Octave_Down == 0 && last_down_state == 1) {
            //debounce
            __delay_ms(20); 
            
            //changes octaves up to 2 down, updates lcd flag
            if (Octave_Down == 0 && octave_level > -2) { octave_level--; update_lcd_flag = 1; }
        }
        //updates state
        last_down_state = Octave_Down;

        // Perform the "Heavy Math" in Main, not the ISR
        if (update_lcd_flag) {
            for(uint8_t i=0; i<12; i++) {
                uint16_t s = phase_steps[i];
                if (octave_level == 1)      s <<= 1;
                else if (octave_level == 2) s <<= 2;
                else if (octave_level == -1) s >>= 1;
                else if (octave_level == -2) s >>= 2;
                adjusted_steps[i] = s;
            }
        }

        // Capture button states
        uint16_t current_chord_mask = 0;
        notes_active[0] = (Play_C == 0);  if(notes_active[0])  current_chord_mask |= (1 << 0);
        notes_active[1] = (Play_CS == 0); if(notes_active[1]) current_chord_mask |= (1 << 1);
        notes_active[2] = (Play_D == 0);  if(notes_active[2])  current_chord_mask |= (1 << 2);
        notes_active[3] = (Play_DS == 0); if(notes_active[3]) current_chord_mask |= (1 << 3);
        notes_active[4] = (Play_E == 0);  if(notes_active[4])  current_chord_mask |= (1 << 4);
        notes_active[5] = (Play_F == 0);  if(notes_active[5])  current_chord_mask |= (1 << 5);
        notes_active[6] = (Play_FS == 0); if(notes_active[6]) current_chord_mask |= (1 << 6);
        notes_active[7] = (Play_G == 0);  if(notes_active[7])  current_chord_mask |= (1 << 7);
        notes_active[8] = (Play_GS == 0); if(notes_active[8]) current_chord_mask |= (1 << 8);
        notes_active[9] = (Play_A == 0);  if(notes_active[9])  current_chord_mask |= (1 << 9);
        notes_active[10] = (Play_AS == 0);if(notes_active[10])current_chord_mask |= (1 << 10);
        notes_active[11] = (Play_B == 0);  if(notes_active[11]) current_chord_mask |= (1 << 11);

        // LCD Update (Only if something changed)
        if (current_chord_mask != last_chord_mask || update_lcd_flag) {
            LCD_clear();
            LCD_cursor_set(1, 1);
            LCD_write_string("Octave: ");
            LCD_write_variable((int32_t)(4 + octave_level), 1);
            LCD_cursor_set(2, 1);
            uint8_t count = 0;
            for(uint8_t i=0; i<12; i++) {
                if(notes_active[i]) {
                    LCD_write_string((char*)note_names[i]);
                    LCD_write_variable((int32_t)(4 + octave_level), 1);
                    LCD_write_string(" ");
                    
                    //if more than 4 buttons pressed, break out(this is the max)
                    if(++count >= 4) break;
                }
            }
            
            //updates mask and lcd flag
            last_chord_mask = current_chord_mask;
            update_lcd_flag = 0;
        }
    }
}
